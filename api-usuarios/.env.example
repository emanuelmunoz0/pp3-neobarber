# Puerto en el que corre la API Usuarios
PORT=3001

# Cadena de conexión a la base de datos de Supabase (PostgreSQL)
# La encontrás en: Supabase > Project Settings > Database > Connection string (URI)
DATABASE_URL=postgresql://postgres:TU_PASSWORD@db.TU_PROYECTO.supabase.co:5432/postgres

# Secreto para firmar los JWT (usá una cadena larga y aleatoria en producción)
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio

# Tiempo de expiración del token
JWT_EXPIRES_IN=1h

# Datos para el seed del usuario admin (dueño de la barbería)
ADMIN_NOMBRE=Dueño Barbería
ADMIN_EMAIL=admin@barberia.com
ADMIN_TELEFONO=1122334455
ADMIN_PASSWORD=CambiarEstaClave123
