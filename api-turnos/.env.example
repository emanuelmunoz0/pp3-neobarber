PORT=3000

# Supabase (PostgreSQL) - base api-turnos-barberia
# Para Vercel usá el Transaction pooler (puerto 6543), no el Session pooler (5432)
DATABASE_URL=postgresql://USUARIO:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Microservicio de usuarios (validación del JWT: GET /validar-token)
USUARIOS_API_URL=https://URL-DE-MS-USUARIOS.vercel.app

# Microservicio de empleados (comprueba que el barbero exista: GET /api/empleados/:id)
EMPLEADOS_API_URL=https://URL-DE-MS-EMPLEADOS.vercel.app

# Orígenes del frontend permitidos por CORS, separados por coma. Admite comodines.
CORS_ORIGINS=http://localhost:5173,https://*.netlify.app

# (Opcional) zona horaria de la barbería; por defecto America/Argentina/Buenos_Aires
# TZ_NEGOCIO=America/Argentina/Buenos_Aires
